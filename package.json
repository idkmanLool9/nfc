{
  "name": "nfc-card-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:build": "cross-env NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_TARGET=capacitor next build",
